@{
    ViewData["Title"] = "Inicio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Estilos específicos para esta vista -->
    <style>
        /* Estilos generales */
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: white; /* Fondo claro */
        }

       

            /* Estilos del logo */
            header img {
                max-width: 80%; /* Ajusta el tamaño máximo del logo */
                height: auto;
            }

     
    </style>
</head>
<body>
    <header>
        <img src="~/images/logo_gobierno_local_completo.png" alt="Logo de la empresa" />
    </header>

  
   
</body>
</html>
