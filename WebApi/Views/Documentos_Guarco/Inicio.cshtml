@{
    ViewData["Title"] = "Inicio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Estilos específicos para esta vista -->
    <style>
       
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: white; 
            position: relative; 
            min-height: 100vh; 
        }

        /* Estilos del logo */
        header img {
            max-width: 80%;
            height: auto;
        }

        
        .quality-tag {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 5rem;
            font-weight: bold;
            color: deepskyblue; 
        }
    </style>
</head>
<body>
    <header>
        <img src="~/images/logo_gobierno_local_completo.png" alt="Logo de la empresa" />
    </header>

    <div class="quality-tag">
        Gestión De Calidad
    </div>
</body>
</html>
</html>
