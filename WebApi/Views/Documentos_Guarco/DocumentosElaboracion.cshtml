@model IEnumerable<WebApi.Models.Documentos_GuarcoModel>

@{
    ViewData["Title"] = "Documentos en Elaboración";
}
<style>

    .quality-tag {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 2rem;
        font-weight: bold;
        color: deepskyblue;
        border-style: solid;
        border-width: thick;
    }

</style>

<div class="quality-tag">
    Gestión De Calidad
</div>


<h1 style="color:deepskyblue;">Lista de Documentos</h1>

<br />
<br />

<!-- FORMULARIO DE BÚSQUEDA (vacío en este caso) -->
<form asp-action="DocumentosElaboracion" asp-controller="Documentos_Guarco" method="get">
</form>

<br />
<br />

@if (Model != null && Model.Any())
{
    <table class="tabla-documentos table-bordered table-striped sin-subrayado">
        <thead>
            <tr>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().id_documento)</th>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().Fecha_inicio)</th>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().Fecha_finalizacion)</th>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().Fecha_revision_inicio)</th>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().Fecha_revision_finalizacion)</th>
                <th style="display:none">@Html.DisplayNameFor(model => model.First().Fecha_aprobacion)</th>
                <th>@Html.DisplayNameFor(model => model.First().codigo)</th>
                <th>@Html.DisplayNameFor(model => model.First().nombre)</th>
                <th>@Html.DisplayNameFor(model => model.First().tipo)</th>
                <th>@Html.DisplayNameFor(model => model.First().nombre_area)</th>
                <th>@Html.DisplayNameFor(model => model.First().estado)</th>
                <th>Acciones</th>
                <th>Modificar</th>
                <th>Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.id_documento)</td>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.Fecha_inicio)</td>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.Fecha_finalizacion)</td>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.Fecha_revision_inicio)</td>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.Fecha_revision_finalizacion)</td>
                    <td style="display:none">@Html.DisplayFor(modelItem => item.Fecha_aprobacion)</td>
                    <td>@Html.DisplayFor(modelItem => item.codigo)</td>
                    <td>@Html.DisplayFor(modelItem => item.nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.tipo)</td>
                    <td>@Html.DisplayFor(modelItem => item.nombre_area)</td>
                    <td>@Html.DisplayFor(modelItem => item.estado)</td>
                    <td>
                        @Html.ActionLink("Ver información", "VerDocumentos", new { pID = item.id_documento }, new { @class = "btn btn-info" })
                    </td>
                    <td>
                        @Html.ActionLink("Modificar", "ModificarDocumentos", new { pID = item.id_documento }, new { @class = "btn btn-secondary" })
                    </td>
                    <td>
                        @Html.ActionLink("Eliminar", "Eliminar_documentos", new { pID = item.id_documento }, new { @class = "btn btn-danger" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No se encontraron documentos.</p>
}
