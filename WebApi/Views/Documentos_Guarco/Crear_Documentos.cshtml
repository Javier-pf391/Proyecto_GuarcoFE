@model WebApi.Models.Documentos_GuarcoModel

@{
    ViewData["Title"] = "Crear Documento";
}
@{
    var areas = new List<SelectListItem>
    {
      new SelectListItem { Text = "Alcadia", Value = "Alcadia" },
      new SelectListItem { Text = "Vice Alcadia", Value = "Vice Alcadia" },
      new SelectListItem { Text = "G.Calidad", Value = "G.Calidad" },
      new SelectListItem { Text = "G.RH", Value = "G.RH" },
      new SelectListItem { Text = "G.Juridica", Value = "G.Juridica" },
      new SelectListItem { Text = "P.Servicios", Value = "P.Servicios" },
      new SelectListItem { Text = "TI", Value = "TI" },
      new SelectListItem { Text = "Planificación", Value = "Planificación" },
      new SelectListItem { Text = "G.Social", Value = "G.Social" },
      new SelectListItem { Text = "Contabilidad", Value = "Contabilidad" },
      new SelectListItem { Text = "Proveeduria", Value = "Proveeduria" },
      new SelectListItem { Text = "Tesoreria", Value = "tesoreria" },
      new SelectListItem { Text = "Presupuesto", Value = "Presupuesto" },
      new SelectListItem { Text = "S.Generales", Value = "S.Generales" },
      new SelectListItem { Text = "S.Ciudadana", Value = "S.Ciudadana" },
      new SelectListItem { Text = "S.Ambientales", Value = "S.Ambientales" },
      new SelectListItem { Text = "GIRH", Value = "GIRH" },
      new SelectListItem { Text = "GIRS", Value = "GIRS" },
      new SelectListItem { Text = "G.Ambiental Ins.", Value = "G.Ambiental Ins." },
      new SelectListItem { Text = "Acueductos", Value = "Acueductos" },
      new SelectListItem { Text = "Mante.Parques", Value = "Mante.Parques" },
      new SelectListItem { Text = "Aseo de Vias", Value = "Aseo de Vias" },
      new SelectListItem { Text = "Reco.Residuos Sol.", Value = "Reco.Residuos Sol" },
      new SelectListItem { Text = "Patentes", Value = "Patentes" },
      new SelectListItem { Text = "Valoracion", Value = "Valoracion" },
      new SelectListItem { Text = "Bienes e Inmuebles", Value = "Bienes e Inmuebles" },
      new SelectListItem { Text = "Cobr.Admin.Judicial", Value = "Cobr.Admin.Judicial" },
      new SelectListItem { Text = "Cons.Plani.Urbana", Value = "Cons.Plani.Urbana" },
      new SelectListItem { Text = "Topografia", Value = "Topografia" },
      new SelectListItem { Text = "Catastro", Value = "Catastro" },
      new SelectListItem { Text = "G.Proyec.Constr", Value = "G.Proyec.Constr" },
      new SelectListItem { Text = "Pro.Social", Value = "Pro.social" },
      new SelectListItem { Text = "G.Proyec.Contratados", Value = "G.Proyec.Contratados" },
      new SelectListItem { Text = "Ofi.Mujer", Value = "Ofi.Mujer" },
      new SelectListItem { Text = "Ninez y Adoles.", Value = "Ninez y Adoles." },
      new SelectListItem { Text = "G.Cultural", Value = "G.Cultural" },

      

    };
}

<h1>Crear Documento</h1>

<form method="post">
    <div class="form-group col-md-6">
        <label asp-for="codigo" class="control-label"></label>
        <input asp-for="codigo" class="form-control" />
        <span asp-validation-for="codigo" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="nombre" class="control-label"></label>
        <input asp-for="nombre" class="form-control" />
        <span asp-validation-for="nombre" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="tipo" class="control-label"></label>
        <input asp-for="tipo" class="form-control" />
        <span asp-validation-for="tipo" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="nombre_area" class="control-label"></label>
        <select asp-for="nombre_area" class="form-control" asp-items="areas">
            <option value=""></option>
        </select>
        <span asp-validation-for="nombre_area" class="text-danger"></span>
    </div>

    <div class="form-group col-md-6">
        <label asp-for="Fecha_inicio" class="control-label"></label>
        <input asp-for="Fecha_inicio" class="form-control" readonly />
        <span asp-validation-for="Fecha_inicio" class="text-danger"></span>
    </div>
    <div class="form-group col-md-12">
        <label asp-for="documento" class="control-label"></label>
        <textarea asp-for="documento" class="form-control" rows="10" style="resize: vertical;"></textarea>
        <span asp-validation-for="documento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" name="action" value="Guardar y Salir" class="btn btn-primary" />
        <input type="submit" name="action" value="Finalizar" class="btn btn-success" />
    </div>
</form>
